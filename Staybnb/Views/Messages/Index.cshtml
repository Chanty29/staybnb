@model List<InboxItemViewModel>
@{
    ViewData["Title"] = "Messages";
}

<h1 class="h3 mb-3">Messages</h1>

@if (!Model.Any())
{
    <div class="text-muted">
        No messages yet. Open a property and click <strong>Message host</strong>, or wait for a host or guest to write to you.
    </div>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var item in Model)
        {
            <a asp-action="Conversation" asp-route-id="@item.Other.Id"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-start @(item.Unread > 0 ? "bg-warning-subtle" : "")">
                <div>
                    <div class="fw-semibold">@item.Other.FullName</div>
                    <div class="text-muted small">
                        @(item.LastMessage.SenderId == item.Other.Id ? "" : "You: ")@(item.LastMessage.Content.Length > 80 ? item.LastMessage.Content[..80] + "..." : item.LastMessage.Content)
                    </div>
                </div>
                <div class="text-end">
                    <div class="small text-muted">@item.LastMessage.Timestamp.ToLocalTime().ToString("d MMM, HH:mm")</div>
                    @if (item.Unread > 0)
                    {
                        <span class="badge bg-danger">@item.Unread unread</span>
                    }
                </div>
            </a>
        }
    </div>
}
