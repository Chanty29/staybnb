@model HostProperty
@using Staybnb.Services
@using System.Globalization
@{
    ViewData["Title"] = Model.Title;
    var images = Model.Images.ToList();
    var inv = CultureInfo.InvariantCulture;
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var tomorrow = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

<a asp-controller="Home" asp-action="Index" class="small">&larr; Back to all stays</a>
<h1 class="h3 mt-2">@Model.Title</h1>
<p class="text-muted">@Model.Address, @Model.City, @Model.Country</p>

<div class="row g-4">
    <div class="col-lg-7">
        @if (images.Any())
        {
            <div id="gallery" class="carousel slide mb-3" data-bs-ride="false">
                <div class="carousel-inner rounded">
                    @for (var i = 0; i < images.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@images[i].ImageUrl" class="d-block w-100" alt="@Model.Title"
                                 style="height: 380px; object-fit: cover;" />
                        </div>
                    }
                </div>
                @if (images.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#gallery" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#gallery" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>
        }

        <div class="mb-3">
            <span class="badge bg-light text-dark border">@Model.PropertyType</span>
            <span class="badge bg-light text-dark border">@Model.MaxGuests guests</span>
            <span class="badge bg-light text-dark border">@Model.Bedrooms bedrooms</span>
            <span class="badge bg-light text-dark border">@Model.Beds beds</span>
            <span class="badge bg-light text-dark border">@Model.Bathrooms bathrooms</span>
        </div>

        <p class="text-muted small">Hosted by @Model.Host.FullName</p>
        <p style="white-space: pre-line;">@Model.Description</p>

        @if (Model.Amenities.Any())
        {
            <h2 class="h5 mt-4">Amenities</h2>
            <div class="row">
                @foreach (var a in Model.Amenities)
                {
                    <div class="col-6 col-md-4 mb-1"><i class="bi @a.IconClass"></i> @a.Name</div>
                }
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm sticky-top" style="top: 1rem;">
            <div class="card-body">
                <div class="fs-5"><strong>R @Model.PricePerNight.ToString("N2")</strong> <span class="text-muted">/ night</span></div>
                <div class="small text-muted mb-3">Cleaning fee: R @Model.CleaningFee.ToString("N2")</div>

                @if (User.IsInRole(AppRoles.Guest))
                {
                    <form asp-controller="Bookings" asp-action="Create" method="post" id="bookingForm"
                          data-price="@Model.PricePerNight.ToString(inv)"
                          data-cleaning="@Model.CleaningFee.ToString(inv)"
                          data-rate="@BookingPricing.ServiceFeeRate.ToString(inv)">
                        <input type="hidden" name="PropertyId" value="@Model.Id" />

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small mb-0">Check-in</label>
                                <input type="date" name="CheckInDate" id="checkIn" class="form-control" min="@today" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-0">Check-out</label>
                                <input type="date" name="CheckOutDate" id="checkOut" class="form-control" min="@tomorrow" required />
                            </div>
                        </div>

                        <label class="form-label small mb-0">Guests</label>
                        <input type="number" name="NumberOfGuests" class="form-control mb-3" min="1" max="@Model.MaxGuests" value="1" required />

                        <div id="priceBox" class="small border rounded p-2 mb-3 d-none">
                            <div class="d-flex justify-content-between"><span id="nightsLabel"></span><span id="subtotal"></span></div>
                            <div class="d-flex justify-content-between"><span>Cleaning fee</span><span id="cleaning"></span></div>
                            <div class="d-flex justify-content-between"><span>Service fee</span><span id="service"></span></div>
                            <hr class="my-1" />
                            <div class="d-flex justify-content-between fw-bold"><span>Total</span><span id="total"></span></div>
                        </div>

                        <button type="submit" class="btn btn-brand w-100">Request to book</button>
                    </form>

                    <a asp-controller="Messages" asp-action="Conversation" asp-route-id="@Model.HostId"
                       class="btn btn-outline-secondary w-100 mt-2">Message host</a>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="alert alert-secondary mb-0 small">Only Guest accounts can book a stay.</div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-brand w-100">Log in to book</a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var form = document.getElementById('bookingForm');
            if (!form) { return; }

            var price = parseFloat(form.dataset.price);
            var cleaning = parseFloat(form.dataset.cleaning);
            var rate = parseFloat(form.dataset.rate);
            var checkIn = document.getElementById('checkIn');
            var checkOut = document.getElementById('checkOut');

            function money(n) { return 'R ' + n.toFixed(2); }

            function update() {
                if (!checkIn.value || !checkOut.value) { return; }
                var nights = Math.round((new Date(checkOut.value) - new Date(checkIn.value)) / 86400000);
                var box = document.getElementById('priceBox');
                if (nights < 1) { box.classList.add('d-none'); return; }

                var subtotal = price * nights;
                var service = Math.round(subtotal * rate * 100) / 100;
                document.getElementById('nightsLabel').textContent = 'R ' + price.toFixed(2) + ' x ' + nights + ' night(s)';
                document.getElementById('subtotal').textContent = money(subtotal);
                document.getElementById('cleaning').textContent = money(cleaning);
                document.getElementById('service').textContent = money(service);
                document.getElementById('total').textContent = money(subtotal + cleaning + service);
                box.classList.remove('d-none');
            }

            checkIn.addEventListener('change', function () {
                if (checkIn.value) {
                    var next = new Date(checkIn.value);
                    next.setDate(next.getDate() + 1);
                    checkOut.min = next.toISOString().slice(0, 10);
                }
                update();
            });
            checkOut.addEventListener('change', update);
        })();
    </script>
}
