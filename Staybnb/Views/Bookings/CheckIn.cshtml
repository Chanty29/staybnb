@model CheckInPageViewModel
@{
    ViewData["Title"] = "Check-in";
    var b = Model.Booking;
    var status = Model.CheckIn?.Status;
    var canUpload = b.Status == BookingStatus.Approved
                    && (status == null || status == CheckInStatus.InProgress || status == CheckInStatus.Rejected);
}

<a asp-action="Index" class="small">&larr; Back to my bookings</a>
<h1 class="h3 mt-2 mb-1">Check-in: @b.Property.Title</h1>
<p class="text-muted">
    @b.CheckInDate.ToString("d MMM yyyy") - @b.CheckOutDate.ToString("d MMM yyyy") &middot;
    <partial name="_BookingStatusBadge" model="b.Status" />
</p>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Step 1: Read the host's steps</h2>
                <p class="small text-muted mb-2">@Model.ProcessTitle</p>
                <ol>
                    @foreach (var step in Model.Steps)
                    {
                        <li>@step</li>
                    }
                </ol>
                <p class="small mb-0">Required documents: <strong>@Model.RequiredDocuments</strong></p>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Step 2: Upload your document</h2>

                @if (status == CheckInStatus.Rejected)
                {
                    <div class="alert alert-danger py-2 small">The host rejected your last document. Please upload it again.</div>
                }

                @if (canUpload)
                {
                    <form asp-action="CheckIn" asp-route-id="@b.Id" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Document type</label>
                            <select name="documentType" class="form-select" required>
                                <option value="ID">ID</option>
                                <option value="Passport">Passport</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">File (JPG, PNG or PDF, max 4 MB)</label>
                            <input type="file" name="document" class="form-control" accept=".jpg,.jpeg,.png,.pdf" required />
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="acceptRules" value="true" id="acceptRules" />
                            <label class="form-check-label" for="acceptRules">I have read the check-in steps and house rules.</label>
                        </div>

                        <button type="submit" class="btn btn-brand">Submit check-in</button>
                    </form>
                }
                else
                {
                    <p class="mb-2">Your document has been uploaded.</p>
                }

                @if (Model.CheckIn != null && Model.CheckIn.Documents.Any())
                {
                    <ul class="list-group list-group-flush mt-3">
                        @foreach (var d in Model.CheckIn.Documents.OrderByDescending(d => d.UploadedAt))
                        {
                            var badge = d.Status == DocumentStatus.Verified ? "bg-success"
                                      : d.Status == DocumentStatus.Rejected ? "bg-danger"
                                      : "bg-warning text-dark";
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span>@d.DocumentType &middot; <span class="small text-muted">@d.UploadedAt.ToLocalTime().ToString("d MMM, HH:mm")</span></span>
                                <span class="badge @badge">@d.Status</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Step 3: Host verification</h2>
                @if (b.Status == BookingStatus.CheckedIn || status == CheckInStatus.Verified)
                {
                    <div class="alert alert-success mb-0">You are checked in. Enjoy your stay!</div>
                }
                else if (status == CheckInStatus.Submitted)
                {
                    <div class="alert alert-warning mb-0">Waiting for the host to verify your document.</div>
                }
                else
                {
                    <div class="text-muted">Submit your document above, then the host verifies it.</div>
                }
            </div>
        </div>
    </div>
</div>
