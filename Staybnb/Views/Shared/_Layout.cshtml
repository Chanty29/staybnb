<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-white border-bottom">
        <div class="container">
            <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">staybnb</a>

            <div class="ms-auto d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.SuperAdmin))
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Admin" asp-action="Dashboard">Admin Dashboard</a>
                    }
                    else if (User.IsInRole(AppRoles.Host))
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Host" asp-action="Dashboard">Host Dashboard</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Guest" asp-action="Dashboard">My Dashboard</a>
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="HostApplication" asp-action="Create">Become a Host</a>
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="HostApplication" asp-action="Status">Application Status</a>
                    }

                    <span class="text-muted small">@User.Identity.Name</span>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-brand btn-sm">Logout</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-brand btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
                }
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">@successMessage</div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @RenderBody()
    </main>

    <footer class="border-top text-muted small py-3 mt-5">
        <div class="container">&copy; @DateTime.Now.Year Staybnb - Programming 742 assignment</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
