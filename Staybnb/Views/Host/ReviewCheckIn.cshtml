@model Booking
@{
    ViewData["Title"] = "Review check-in";
    var checkIn = Model.GuestCheckIn;
    var canReview = checkIn != null && checkIn.Status == CheckInStatus.Submitted && Model.Status == BookingStatus.Approved;
}

<a asp-action="Bookings" class="small">&larr; Back to booking requests</a>
<h1 class="h3 mt-2 mb-1">Check-in review</h1>
<p class="text-muted">
    @Model.Guest.FullName (@Model.Guest.Email) &middot; @Model.Property.Title &middot;
    @Model.CheckInDate.ToString("d MMM") - @Model.CheckOutDate.ToString("d MMM yyyy")
</p>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5">Uploaded documents</h2>

        @if (checkIn == null || !checkIn.Documents.Any())
        {
            <p class="text-muted mb-0">The guest has not uploaded anything yet.</p>
        }
        else
        {
            <ul class="list-group list-group-flush mb-3">
                @foreach (var d in checkIn.Documents.OrderByDescending(d => d.UploadedAt))
                {
                    var badge = d.Status == DocumentStatus.Verified ? "bg-success"
                              : d.Status == DocumentStatus.Rejected ? "bg-danger"
                              : "bg-warning text-dark";
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@d.DocumentType</strong>
                            <span class="small text-muted">uploaded @d.UploadedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="badge @badge">@d.Status</span>
                            <a asp-action="Document" asp-route-id="@d.Id" target="_blank" class="btn btn-outline-secondary btn-sm">Open file</a>
                        </div>
                    </li>
                }
            </ul>
        }

        @if (canReview)
        {
            <div class="d-flex gap-2">
                <form asp-action="VerifyCheckIn" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-success">Verify and check in guest</button>
                </form>
                <form asp-action="RejectCheckIn" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-outline-danger">Reject document</button>
                </form>
            </div>
        }
        else if (checkIn != null)
        {
            <div class="small text-muted">Check-in status: @checkIn.Status</div>
        }
    </div>
</div>
