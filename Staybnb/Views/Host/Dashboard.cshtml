@model HostDashboardViewModel
@{
    ViewData["Title"] = "Host Dashboard";
}

<h1 class="h3 mb-1">Host dashboard</h1>
<p class="text-muted">Manage your listings and booking requests.</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Properties</div>
            <div class="fs-2 fw-bold">@Model.TotalProperties</div>
            <div class="small text-muted">@Model.ActiveProperties active</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-action="Bookings" asp-route-status="@BookingStatus.Pending" class="text-decoration-none text-reset">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">Pending requests</div>
                <div class="fs-2 fw-bold @(Model.PendingRequests > 0 ? "text-warning" : "")">@Model.PendingRequests</div>
                <div class="small text-muted">Click to review</div>
            </div></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Upcoming stays</div>
            <div class="fs-2 fw-bold">@Model.UpcomingStays</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Earnings</div>
            <div class="fs-2 fw-bold">R @Model.Earnings.ToString("N2")</div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h5 mb-0">Recent bookings</h2>
            <a asp-action="Bookings" class="small">View all</a>
        </div>

        @if (!Model.RecentBookings.Any())
        {
            <p class="text-muted mb-0">No bookings yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Property</th><th>Guest</th><th>Dates</th><th>Total</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td>@b.Property.Title</td>
                                <td>@b.Guest.FullName</td>
                                <td class="small">@b.CheckInDate.ToString("d MMM") - @b.CheckOutDate.ToString("d MMM yyyy")</td>
                                <td>R @b.TotalPrice.ToString("N2")</td>
                                <td><partial name="_BookingStatusBadge" model="b.Status" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
