@model List<Booking>
@{
    ViewData["Title"] = "Booking Requests";
    var filter = ViewData["Filter"] as BookingStatus?;
}

<h1 class="h3 mb-3">Booking requests</h1>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Bookings" class="btn btn-sm @(filter == null ? "btn-dark" : "btn-outline-secondary")">All</a>
    @foreach (var s in Enum.GetValues<BookingStatus>())
    {
        <a asp-action="Bookings" asp-route-status="@s" class="btn btn-sm @(filter == s ? "btn-dark" : "btn-outline-secondary")">@s</a>
    }
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Property</th>
                    <th>Guest</th>
                    <th>Dates</th>
                    <th>Guests</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No bookings found.</td></tr>
                }

                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.Property.Title</td>
                        <td>
                            <div>@b.Guest.FullName</div>
                            <div class="small text-muted">@b.Guest.Email</div>
                        </td>
                        <td class="small">@b.CheckInDate.ToString("d MMM") - @b.CheckOutDate.ToString("d MMM yyyy")<br />@b.Nights night(s)</td>
                        <td>@b.NumberOfGuests</td>
                        <td>R @b.TotalPrice.ToString("N2")</td>
                        <td><partial name="_BookingStatusBadge" model="b.Status" /></td>
                        <td class="text-end">
                            @if (b.GuestCheckIn != null && b.Status != BookingStatus.Cancelled)
                            {
                                <a asp-action="ReviewCheckIn" asp-route-id="@b.Id" class="btn btn-outline-primary btn-sm">
                                    Check-in: @b.GuestCheckIn.Status
                                </a>
                            }
                            @if (b.Status == BookingStatus.Pending)
                            {
                                <div class="d-flex gap-1 justify-content-end">
                                    <form asp-action="ApproveBooking" asp-route-id="@b.Id" method="post">
                                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                    </form>
                                    <form asp-action="RejectBooking" asp-route-id="@b.Id" method="post">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
