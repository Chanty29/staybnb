@model List<HostProperty>
@{
    ViewData["Title"] = "My Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My properties</h1>
    <a asp-controller="HostApplication" asp-action="Create" class="btn btn-brand btn-sm">Add another property</a>
</div>

@if (!Model.Any())
{
    <div class="text-muted">You have no properties yet.</div>
}

<div class="row g-3">
    @foreach (var p in Model)
    {
        var cover = p.Images.FirstOrDefault();
        var app = p.Applications.OrderByDescending(a => a.AppliedAt).FirstOrDefault();
        var appBadge = app == null ? null
            : app.Status == ApplicationStatus.Approved ? "bg-success"
            : app.Status == ApplicationStatus.Rejected ? "bg-danger"
            : "bg-warning text-dark";
        var canToggle = app == null || p.Applications.Any(a => a.Status == ApplicationStatus.Approved);

        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                @if (cover != null)
                {
                    <img src="@cover.ImageUrl" alt="@p.Title" class="card-img-top" style="height: 180px; object-fit: cover;" />
                }
                <div class="card-body">
                    <h2 class="h6 mb-1">@p.Title</h2>
                    <div class="small text-muted mb-2">@p.City &middot; R @p.PricePerNight.ToString("N2") / night</div>

                    <div class="mb-2">
                        @if (app != null)
                        {
                            <span class="badge @appBadge">Application: @app.Status</span>
                        }
                        <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "Active" : "Inactive")</span>
                        <span class="badge bg-light text-dark border">@p.Bookings.Count booking(s)</span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        @if (canToggle)
                        {
                            <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    @(p.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                        <a asp-action="CheckIn" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm">Check-in rules</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
