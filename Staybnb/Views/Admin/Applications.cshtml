@model List<HostApplication>
@{
    ViewData["Title"] = "Host Applications";
    var pending = Model.Where(a => a.Status == ApplicationStatus.Pending).ToList();
    var reviewed = Model.Where(a => a.Status != ApplicationStatus.Pending).ToList();
}

<h1 class="h3 mb-3">Host applications</h1>

<h2 class="h5">Waiting for review (@pending.Count)</h2>

@if (!pending.Any())
{
    <div class="text-muted mb-4">No applications are waiting.</div>
}
else
{
    foreach (var item in pending)
    {
        var cover = item.Property.Images.FirstOrDefault();

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-3 mb-md-0">
                        @if (cover != null)
                        {
                            <img src="@cover.ImageUrl" alt="@item.Property.Title" class="img-fluid rounded"
                                 style="height: 140px; width: 100%; object-fit: cover;" />
                        }
                        <div class="small text-muted mt-1">@item.Property.Images.Count photo(s)</div>
                    </div>

                    <div class="col-md-9">
                        <h3 class="h5 mb-1">@item.Property.Title</h3>
                        <div class="text-muted small mb-2">
                            @item.Property.Address, @item.Property.City &middot; @item.Property.PropertyType
                            &middot; R @item.Property.PricePerNight.ToString("N2") / night
                        </div>
                        <p class="small mb-2">@item.Property.Description</p>
                        <div class="small text-muted mb-3">
                            Applicant: <strong>@item.ApplicationUser.FullName</strong> (@item.ApplicationUser.Email)
                            &middot; Applied @item.AppliedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-start">
                            <form asp-action="ApproveApplication" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-success btn-sm"
                                        onclick="return confirm('Approve this application? The applicant becomes a Host.');">
                                    Approve
                                </button>
                            </form>

                            <form asp-action="RejectApplication" asp-route-id="@item.Id" method="post" class="d-flex gap-2 flex-grow-1">
                                <input name="reason" class="form-control form-control-sm" maxlength="500"
                                       placeholder="Reason for rejecting (required)" required />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

<h2 class="h5 mt-4">Reviewed (@reviewed.Count)</h2>

@if (!reviewed.Any())
{
    <div class="text-muted">Nothing has been reviewed yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Applicant</th>
                        <th>Property</th>
                        <th>Status</th>
                        <th>Reviewed</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in reviewed)
                    {
                        var badge = item.Status == ApplicationStatus.Approved ? "bg-success" : "bg-danger";
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.ApplicationUser.FullName</div>
                                <div class="small text-muted">@item.ApplicationUser.Email</div>
                            </td>
                            <td>@item.Property.Title</td>
                            <td><span class="badge @badge">@item.Status</span></td>
                            <td class="small">@(item.ReviewedAt.HasValue ? item.ReviewedAt.Value.ToLocalTime().ToString("d MMM yyyy, HH:mm") : "-")</td>
                            <td class="small">@(string.IsNullOrWhiteSpace(item.RejectionReason) ? "-" : item.RejectionReason)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
