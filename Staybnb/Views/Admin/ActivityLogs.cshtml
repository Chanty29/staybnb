@using Microsoft.AspNetCore.Mvc.Rendering
@model ActivityLogsViewModel
@{
    ViewData["Title"] = "Activity Log";
}

<h1 class="h3 mb-1">Activity log</h1>
<p class="text-muted">Every login, role change and booking status update is recorded here. @Model.TotalItems entries.</p>

<form method="get" asp-action="ActivityLogs" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <select name="type" class="form-select">
            <option value="">All types</option>
            @foreach (var t in Enum.GetValues<ActivityType>())
            {
                <option value="@t" selected="@(Model.Filter == t)">@t</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-brand">Filter</button>
        <a asp-action="ActivityLogs" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>When</th>
                    <th>User</th>
                    <th>Type</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No entries.</td></tr>
                }

                @foreach (var log in Model.Items)
                {
                    <tr>
                        <td class="small text-nowrap">@log.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm:ss")</td>
                        <td>
                            @if (log.User != null)
                            {
                                <div>@log.User.FullName</div>
                                <div class="small text-muted">@log.User.Email</div>
                            }
                            else
                            {
                                <span class="text-muted">System / unknown</span>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@log.ActivityType</span></td>
                        <td>@log.Action</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <div class="small text-muted">Page @Model.Page of @Model.TotalPages</div>
        <div class="d-flex gap-2">
            @if (Model.Page > 1)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="ActivityLogs"
                   asp-route-type="@Model.Filter" asp-route-page="@(Model.Page - 1)">Previous</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="ActivityLogs"
                   asp-route-type="@Model.Filter" asp-route-page="@(Model.Page + 1)">Next</a>
            }
        </div>
    </nav>
}
